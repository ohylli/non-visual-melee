wait "state 0 scene 0$"
sleep 1.0
shot "build/drive/title-1.png"
sleep 2.0
shot "build/drive/title-2.png"
press Start until "boot scene: game mode"
press A until "boot scene: state 0 scene 1$"
wait "menu 0 entry 0," 10
sleep 1.0
press Down
wait "menu 0 entry 1," 5
press Down
wait "menu 0 entry 2," 5
press Down
wait "menu 0 entry 3," 5
press A
wait "menu 4 entry 0," 5
sleep 0.8
press Down
wait "menu 4 entry 1," 5
sleep 0.5
# into Sound
press A
sleep 2.0
shot "build/drive/sound-1-opened.png"
press Right
sleep 1.0
shot "build/drive/sound-2-right.png"
press Down
sleep 1.0
shot "build/drive/sound-3-down.png"
press Right
sleep 0.6
press Right
sleep 0.6
press Right
sleep 1.0
shot "build/drive/sound-4-right3.png"
press Left
sleep 0.6
press Left
sleep 0.6
press Left
sleep 0.6
press Left
sleep 0.6
press Left
sleep 0.6
press Left
sleep 1.0
shot "build/drive/sound-5-left6.png"
# restore: slider to centre, first row to Stereo
press Right
sleep 0.6
press Right
sleep 0.6
press Right
sleep 0.6
press Up
sleep 0.8
press Left
sleep 1.0
shot "build/drive/sound-6-restored.png"
press B
wait "menu 4 entry 1," 8
sleep 0.8
press Down
wait "menu 4 entry 2," 5
sleep 0.5
# into Screen Display
press A
sleep 2.0
shot "build/drive/display-1-opened.png"
press A
sleep 1.2
shot "build/drive/display-2-A.png"
press A
sleep 1.2
shot "build/drive/display-3-A-again.png"
press B
wait "menu 4 entry 2," 8
sleep 0.8
press Down
wait "menu 4 entry 4," 5
sleep 0.5
# into Language: no A, no Left/Right
press A
sleep 2.0
shot "build/drive/language-1-opened.png"
press B
wait "menu 4 entry 4," 8
sleep 1.0
