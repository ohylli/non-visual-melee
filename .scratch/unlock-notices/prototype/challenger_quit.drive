# Boot through the memory card scene (--scene ""), skip the opening movie,
# title, main menu, VS Mode, Melee, character select.
wait '"Opening movie\. Press Start to skip\."' 60
press Start until '"Title screen\. Press Start\."' 20 1
sleep 1
press Start until '"Main Menu\. ' 20 1
sleep 1
press Down
wait '"VS\. Mode\. '
press A
wait '"VS\. Mode\. Melee\. '
sleep 0.3
press A
wait '"Character select\. Player 1, no character\."'
sleep 1
# Fox for player 1.
press DUp
wait ': "Player 1: closed"$'
press DUp
wait ': "Pichu"$'
press DUp
wait ': "Fox"$'
wait 'glide to "Fox" ended after \d+ frames: arrived'
press A
sleep 1
# Player 2 a CPU.
search ': "Player 2: closed"$' DDown*2 DRight*3 DLeft*3
wait 'glide to "Player 2: closed" ended'
press A until 'Ready to fight\. Press Start\.'
sleep 0.5
# Random stage, then quit from the pause: a no-contest match.
press Start
wait '"Stage select\. '
sleep 1
press Start
sleep 8
press Start
sleep 1
press L+R+A+Start 1000
press Start until '"Time Battle\. No contest\. ' 5 2
press Start
wait '"KOs and falls\. '
sleep 0.5
press Start
wait '"New challenger"$'
sleep 1.5
shot build/drive/chal/nocontest.png
