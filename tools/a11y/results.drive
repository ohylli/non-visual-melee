# Results after a VS match, offline: the debug match (Link, player 1, against
# a CPU Mario, one stock each on Battlefield) ends with Link walking off the
# stage. Results stays silent while the announcer names the winner, then says
# its opening: the match type, the winner, each player in place order with
# their summary, the keys on the first results of the run, and "Start when
# ready." A D-pad press then opens the stats panels, said as the page and
# its first row with the keys; the reading cursor steps down and up, switches
# to Mario, says his summary line with Z, and A and B page each way. Start
# makes player 1 ready with the confirm sound, and with no other human the
# debug match starts again.
# Run from Git Bash with the debug match switches:
#   MELEE_DEBUG_VS=cpu MELEE_DEBUG_VS_STOCKS=1 MELEE_DEBUG_VS_STAGE=31 \
#     python tools/a11y/drive.py tools/a11y/results.drive

# Start on the title screen goes straight into the debug match.
wait "state 0 scene 0$"
press Start until "boot scene: state \d+ scene 2$"
sleep 2

# Left off the stage's edge, and on falling to the end of the match.
press Left 6000
wait '"Stock Battle\. Winner: Mario\. 1st Mario, P2, .*\. 2nd Link, P1, you, .*KO.d at \d+:\d\d\. Any button shows the stats\. Start when ready\."$' 60

# The opening comes once presses count; the first press only opens the
# panels, whichever button it is.
press DDown
wait '"KOs and falls\. KOs\. A and B change page\. D-pad up and down read the rows, left and right switch player\. Z the player.s summary\. Start when ready\."$'

# The reading cursor over your KOs and falls, then Mario's.
press DDown
wait '"P2 Mario, 0"$'
press DDown
wait '"Falls"$'
press DUp
wait '"P2 Mario, 0"$'
press DRight
wait '"Mario, P2, P1 Link, you, 0"$'
press Z
wait '"Mario, P2, 1st, 0 KOs, 0 falls, 0 SDs, not KO.d\."$'

# A pages forward, keeping Mario; a switch back says only the value.
press A
wait '"Stats\. KOs, 0\."$'
press DDown
wait '"Falls, 0"$'
press DLeft
wait '"Link, P1, you, 0"$'
press A
wait '"Bonuses\. ([^,"]+, -?\d+|No bonuses)\."$'
press B
wait '"Stats\. KOs, 0\."$'
press B
wait '"KOs and falls\. KOs\."$'

press Start
wait 'boot scene: state \d+ scene 2$'
