# Two instances meet by Direct Connect, go on into character select, back
# out of it to the hub, meet again from b's recent opponent row and lose the
# connection when a closes, for tools/a11y/drive_net.py --direct: each boots
# into DIRECT CONNECT's hub with a fresh code, a waits for a call and b
# dials a's code. They meet only through the router's public address, so the
# router must loop its own address back in (NAT loopback); the maintainer's
# does that for ports it forwards, so UDP 42050 and 42051 are forwarded to
# this machine. The second call fails while the base port's netcode carries
# the back-out's held B into the next session (docs/a11y/netplay.md, "A
# session after a back-out").
#   python tools/a11y/drive_net.py --direct --muted tools/a11y/direct_connect.drive
# Instance b may be a base port build (--base-b): only the opening of
# character select is speech, so its b-base steps wait on the scene instead.
# No step presses Y or chooses the clipboard row: both use the real
# clipboard. Up from the hub's top row wraps to its last, "Wait for a friend
# to call me", whatever rows the clipboard and recent opponents add above.

a wait "lobby: direct connect hub" 60
b wait "lobby: direct connect hub" 60
sleep 1

# a waits. b goes to "Enter a friend's code", the row above the last, and
# types a's code on the code keyboard.
a press DUp
a press A
a wait "lobby: direct connect waiting as '"
b press DUp
b press DUp
b press A
sleep 0.5
b dial a

# Each finds the other on the DHT and says hello to its public address; the
# router has to send those packets back in. Then the session, and both
# enter character select.
a wait "match: recv valid MatchHello" 180
b wait "match: recv valid MatchHello" 60
a wait "net: rollback with" 60
b wait "net: rollback with" 60
a wait "lobby: entering CSS" 60
b wait "lobby: entering CSS" 60
a wait '"Character select\. Player 1, no character\.'
b-fork wait '"Character select\. Player 2, no character\.'
b-base wait 'boot scene: state \d+ scene 8$'
sleep 2

# Holding B on character select backs out: both return to the hub.
a press B 1500
a wait "lobby: direct connect hub, " 30
b wait "lobby: direct connect hub, 1 recent, clipboard -$" 30
sleep 1

# Again, b calling from the recent opponent row: a's code, its top row
# since no code is on the clipboard (the wait above checks).
a press DUp
a press A
a wait "lobby: direct connect waiting as '"
b press A
b wait "lobby: direct connect calling '[^']*#"
a wait "lobby: entering CSS" 180
b wait "lobby: entering CSS" 60
a wait '"Character select\. Player 1, no character\.'
b-fork wait '"Character select\. Player 2, no character\.'
b-base wait 'boot scene: state \d+ scene 8$'
sleep 2

# a closes on character select, and b returns to the hub.
a quit
b wait "net: peer left" 30
b wait "lobby: direct connect hub" 30
sleep 1
