# Match announcements online, for tools/a11y/drive_net.py --muted: two
# instances in one session over loopback. Player 1 (instance a, Pichu)
# sets the rules to two stocks and picks Final Destination; player 2
# chooses by stick. Pichu's Thunder Jolts hit player 2 and give Pichu
# recoil until both players' damage is said; then each player runs off an
# edge for a stock. Each copy says its own player's damage and stocks in
# your voice and the other's in the opponents' voice, with no label, as an
# online match is one against one; drive_net.py checks the session stayed
# in sync. About 45 seconds.
#   python tools/a11y/drive_net.py --muted tools/a11y/match_net.drive
# --muted keeps Accessibility on in both, so the voices render and log
# their "plays" lines. With --base-b DIR, player 2 is a base port build,
# which says nothing: a alone says both players' lines, and b's b-base
# steps wait on scene changes.

# Title screen to the main menu (tools/a11y/main_menu.drive), once the
# session is up: both instances walk the menus a's presses move.
a wait "net: rollback with"
b wait "net: rollback with"
a wait "state 0 scene 0$"
a press Start until "boot scene: game mode"
a press A until "boot scene: state 0 scene 1$" 20 0.3
a wait '"Main Menu\. 1-P Mode\. '
sleep 1

# VS. Mode, Melee.
a press Down
a wait '"VS\. Mode\. '
a press A
a wait '"VS\. Mode\. Melee\. '
sleep 0.3
a press A
a wait '"Character select\. Player 1, no character\."'
b-fork wait '"Character select\. Player 2, no character\."'
b-base wait 'boot scene: state \d+ scene 8$'
sleep 1

# Pichu for player 1, which leaves the hand free.
a press DUp
a wait ': "Player 1: closed"$'
a press DUp
a wait ': "Pichu"$'
a wait 'glide to "Pichu" ended after \d+ frames: arrived'
a press A
sleep 1

# Up to the rules header and into Custom Rules: Stock, two stocks.
a search ': "Rules: 2-minute KO fest!"$' DUp*6 DRight*4
a wait 'glide to "Rules: 2-minute KO fest!" ended after \d+ frames: arrived'
a press A
a wait ': "Custom Rules\. Rules: Time\. '
sleep 1
a press Right
a wait ': "Stock\. '
a press Down
a wait ': "Stock: 3\. '
a press Left
a wait ': "2"$'
a press B
a wait '"Character select\. '
sleep 1

# Player 2 pushes the stick up into the portraits and chooses there.
b press Up 450
b-fork wait '"Holding your coin'
b-base sleep 0.5
sleep 1
b press A
b-fork wait 'Ready to fight\. Press Start\.'
b-base sleep 1
sleep 1

# Stage select: player 1 picks Final Destination, player 2 Icicle Mountain
# (a base port player 2 Random), and the default seed's coin flip takes
# player 1's.
a press Start
a wait '"Stage select\. '
b-fork wait '"Stage select\. '
b-base wait 'boot scene: state \d+ scene 9$'
sleep 1
a press DDown
a wait ': "Icicle Mountain\. '
a wait 'glide to "Icicle Mountain" ended after \d+ frames: arrived'
a search ': "Final Destination\. ' DDown*4 DRight*3
a wait 'glide to "Final Destination" ended after \d+ frames: arrived'
a press A
a wait "sss: we picked"
b-fork press DDown
b-fork wait ': "Icicle Mountain\. '
b-fork wait 'glide to "Icicle Mountain" ended after \d+ frames: arrived'
b-fork press A
b-fork wait "sss: we picked"
b-base press Start
b-base wait "sss: we picked 30$"
a wait 'boot scene: state \d+ scene 2$'
b wait 'boot scene: state \d+ scene 2$'
sleep 3

# Pichu's Thunder Jolts run along the floor into player 2 and give Pichu
# a little recoil: player 2's damage settles, said in the opponents' voice
# on a and in your voice on b, and Pichu's own, in your voice on a and in
# the opponents' voice on b. Nothing was said at GO.
a search 'voice opponents: "\d+"$' B*12
b-fork wait 'voice yours: "\d+"$' 5
a search 'voice yours: "\d+"$' B*6
b-fork wait 'voice opponents: "\d+"$' 5
sleep 1

# Pichu runs off the left edge: "last stock" in your voice on a and in the
# opponents' voice on b.
a press Left 3000
a wait 'voice yours: "last stock"$' 20
b-fork wait 'voice opponents: "last stock"$' 5
sleep 1

# Player 2 runs off the right edge: the same the other way round.
b press Right 3000
a wait 'voice opponents: "last stock"$' 20
b-fork wait 'voice yours: "last stock"$' 5
sleep 2
