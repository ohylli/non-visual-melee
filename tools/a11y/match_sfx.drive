# Positional sound effects in a Training match on Final Destination: Pichu
# (player 1) against a standing CPU on the right. Pichu jumps where it
# stands, whose sounds stay centred at their own volume as your own, then
# runs right and jabs the CPU, whose sounds come from the right, quieter
# than at hand while far and nearer full as Pichu closes in; then Finish
# leaves the match. Each placed start logs an "sfx placed" line.
#   python tools/a11y/drive.py --muted tools/a11y/match_sfx.drive
# --muted keeps Accessibility on, which positional sound effects follow,
# with nothing sent to the screen reader.

# Title screen to the main menu (tools/a11y/main_menu.drive).
wait "state 0 scene 0$"
press Start until "boot scene: game mode"
press A until "boot scene: state 0 scene 1$" 20 0.3
wait '"Main Menu\. 1-P Mode\. '
sleep 1

# 1-P Mode, Training.
press A
wait '"1-P Mode\. Regular Match\. '
sleep 0.3
press Down
wait '"Event Match\. '
press Down
wait '"Stadium\. '
press Down
wait '"Training\. '
sleep 0.3
press A
wait '"Training character select\. Player 1, no character\. CPU, (?P<cpu>.+)\."$'
sleep 1

# Pichu, which makes the match ready (tools/a11y/css_training.drive).
press DUp
wait ': "Holding your coin\. Pichu"$'
wait 'glide to "Pichu[^"]*" ended after \d+ frames: arrived'
press A
wait 'Ready to fight\. Press Start\.'
sleep 0.5
press Start
wait '"Stage select\. '
sleep 1

# Final Destination, at the end of the bottom row.
press DDown
wait ': "Icicle Mountain\. '
search ': "Final Destination\. ' DDown*4 DRight*5
wait 'glide to "Final Destination" ended after \d+ frames: arrived'
press A

# Training has no Ready and GO: the cue starts once the fighters land, with
# Pichu on the left half (pan below 0) and the CPU far on the right (the
# slow pulse).
wait 'cue your position start pan -0\.\d+ pitch [\d.]+ gain 1\.00 interval 0\.800' 120
sleep 1

# A jump where Pichu stands: your own sound, centred at its own volume.
press X 100 until 'sfx placed: track 0x[0-9A-F]+ slot 0 pan 128 volume \d+ gain 1\.00' 3
sleep 1

# A run right to the CPU and jabs until the CPU makes a sound: slot 1, from
# the right (pan above the centre).
press Right 1000
sleep 1.8
press A until 'sfx placed: track 0x[0-9A-F]+ slot 1 pan (129|1[3-9]\d|2\d\d) ' 8 0.4
sleep 1

# Finish, the menu's last row, leaves Training for character select.
press Start
sleep 1
search 'boot scene: state \d+ scene' Up A
sleep 2
