# Character select set up for a match by D-pad and buttons alone: a
# character for player 1, the top bar and back, player 2 made a CPU, its
# coin found, picked up and carried to another portrait, its CPU level set
# to 5, Start, and Start again on stage select. Every step names its
# destination at the press.
# Run with the default --scene title:
#   python tools/a11y/drive.py tools/a11y/css_setup.drive
# drive.py turns steering on (MELEE_A11Y_STEER=1). --no-card unlocks every
# character. Every slot is closed on arrival, and player 2's controller is
# unplugged, so its button skips "human".

# Title screen to the main menu (tools/a11y/main_menu.drive).
wait "state 0 scene 0$"
press Start until "boot scene: game mode"
press A until "boot scene: state 0 scene 1$"
wait '"Main Menu\. 1-P Mode\. '
sleep 1

# VS. Mode, Melee.
press Down
wait '"VS\. Mode\. '
press A
wait '"VS\. Mode\. Melee\. '
sleep 0.3
press A
wait '"Character select\. Player 1, no character\."'
sleep 1

# Up from the hand's start to player 1's button, then into the portraits,
# where the coin jumps into the hand; A on Fox chooses.
press DUp
wait ': "Player 1: closed"$'
press DUp
wait ': "Pichu"$'
press DUp
wait ': "Fox"$'
wait 'glide to "Fox" ended after \d+ frames: arrived'
press A
sleep 1

# Up through the top row to the top bar, along it without pressing A, and
# down again. Right at Back, the row's end, names it again.
press DUp
wait ': "Mario"$'
press DUp
wait ': "Teams: off"$'
wait 'glide to "Teams: off" ended after \d+ frames: arrived'
press DRight
wait ': "Rules"$'
wait 'glide to "Rules" ended after \d+ frames: arrived'
press DRight
wait ': "Back"$'
wait 'glide to "Back" ended after \d+ frames: arrived'
press DRight
wait ': "Back"$'
press DDown
wait ': "Ganondorf"$'
press DDown
wait ': "Young Link"$'
press DDown
wait ': "Roy"$'

# Down into the player slots and left to player 2's button; A until it is a
# CPU, which gets a random character.
press DDown
wait ': "Player 4: closed"$'
press DLeft
wait ': "Player 3: closed"$'
press DLeft
wait ': "Player 2: closed"$'
wait 'glide to "Player 2: closed" ended after \d+ frames: arrived'
press A until ': "Player 2: CPU, (?P<cpu>[^"]+?)(\. Ready to fight\. Press Start\.)?"$'

# Up into the bottom row, and over every portrait until a step names the
# CPU's coin; the glide aims where A picks it up.
search ': "%cpu%, player 2.s coin"$' DUp DLeft DRight*6 DUp DRight DLeft*8 DUp DRight*8
wait 'glide to "%cpu%" ended after \d+ frames: arrived'
press A
wait ': "Holding player 2.s coin'
sleep 0.5

# One step to another portrait, Left or else Right, and A chooses for the
# CPU; with player 1's Fox the match is ready.
search ': "(?!%cpu%")[^"]+"$' DLeft DRight
wait 'glide to "[^"]+" ended after \d+ frames: arrived'
press A
wait 'Ready to fight\. Press Start\.'
sleep 0.5

# Down into the player slots and along them to the CPU level knob. Grabbing
# it takes Ready to Fight away; Left down to 1 and Right up to 5, one level
# a step, each said at the press; releasing it brings Ready to Fight back.
search ': "Player 2 CPU level: \d"$' DDown*3 DLeft*5 DRight*7
wait 'glide to "Player 2 CPU level: \d" ended after \d+ frames: arrived'
press A
wait ': "Holding the slider"$'
press DLeft until ': "Level 1"$' 9
press DRight
wait ': "Level 2"$'
press DRight
wait ': "Level 3"$'
press DRight
wait ': "Level 4"$'
press DRight
wait ': "Level 5"$'
wait 'glide to "Level 5" ended after \d+ frames: arrived'
press DUp
wait ': "Level 5"$'
press A
wait ': "Released\. Ready to fight\. Press Start\."$'
sleep 0.5

# Start leaves for stage select, and Start there picks a random stage.
press Start
wait '"Stage select\. '
sleep 1
press Start
wait 'boot scene: state \d+ scene 2$'
sleep 3
