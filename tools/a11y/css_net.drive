# Character select steered online, for tools/a11y/drive_net.py: two
# instances in one session over loopback. Player 1 (instance a) steps with
# the D-pad to a portrait three columns and one row from the first it
# reaches, chooses, and steps down to its player slot; player 2 (instance b)
# chooses by stick. Each hears the other's choice. Then Start into stage
# select, where each steps to a stage by D-pad and picks it, hears that it
# waits, and hears the coin flip's result from its own side; then the
# match.
#   python tools/a11y/drive_net.py [--delay N] [--sim-delay-ms MS] tools/a11y/css_net.drive
# Each step waits for its glide to arrive, so the summary lists every glide's
# frames at the run's delay.
# With --base-b DIR, player 2 is a base port build, which says nothing: its
# b-base steps wait on the scene changes and sleep where its b-fork steps
# would wait on its speech.

# Title screen to the main menu (tools/a11y/main_menu.drive), once the
# session is up: both instances walk the menus a's presses move.
a wait "net: rollback with"
b wait "net: rollback with"
a wait "state 0 scene 0$"
a press Start until "boot scene: game mode"
a press A until "boot scene: state 0 scene 1$" 20 0.3
a wait '"Main Menu\. 1-P Mode\. '
sleep 1

# VS. Mode, Melee.
a press Down
a wait '"VS\. Mode\. '
a press A
a wait '"VS\. Mode\. Melee\. '
sleep 0.3
a press A
a wait '"Character select\. Player 1, no character\."'
b-fork wait '"Character select\. Player 2, no character\."'
b-base wait 'boot scene: state \d+ scene 8$'
sleep 1

# Up from the hand's start to player 1's button, and into the bottom row at
# Pichu; the coin jumps into the hand on the way.
a press DUp
a wait ': "Player 1: closed"$'
a wait 'glide to "Player 1: closed" ended after \d+ frames: arrived'
a press DUp
a wait ': "Pichu"$'
a wait 'glide to "Pichu" ended after \d+ frames: arrived'

# Three columns right and one row up, to Kirby; A chooses.
a press DRight
a wait ': "Pikachu"$'
a wait 'glide to "Pikachu" ended after \d+ frames: arrived'
a press DRight
a wait ': "Jigglypuff"$'
a wait 'glide to "Jigglypuff" ended after \d+ frames: arrived'
a press DRight
a wait ': "Mewtwo"$'
a wait 'glide to "Mewtwo" ended after \d+ frames: arrived'
a press DUp
a wait ': "Kirby"$'
a wait 'glide to "Kirby" ended after \d+ frames: arrived'
a press A
b-fork wait ': "Player 1: Kirby"$'
sleep 0.5

# Down through the bottom row into the player slots, and left along them to
# player 1's.
a press DDown
a wait ': "Mewtwo"$'
a wait 'glide to "Mewtwo" ended after \d+ frames: arrived'
a search ': "Player 1[: ][^"]*"$' DDown DLeft*6
a wait 'glide to "Player 1[: ][^"]*" ended after \d+ frames: arrived'

# Player 2 pushes the stick up into the portraits, where the coin jumps into
# the hand and the carried coin names each portrait it enters. Once the
# hand stops, A chooses, and player 1 hears the choice.
b press Up 450
b-fork wait '"Holding your coin'
b-base sleep 0.5
sleep 1
b press A
a wait ': "Player 2: (Dr\. Mario|Mario|Luigi|Bowser|Peach|Yoshi|DK|C\. Falcon|Ganondorf|Falco|Fox|Ness|Ice Climbers|Kirby|Samus|Zelda|Link|Young Link|Pichu|Pikachu|Jigglypuff|Mewtwo|Mr\. Game & Watch|Marth|Roy)(\. Ready to fight\. Press Start\.)?"$'
b-fork wait 'Ready to fight\. Press Start\.'
sleep 1

# Start leaves for stage select. Online each player picks a stage there on
# their own stage cursor, and a coin flip on the session's seed chooses
# between the two picks.
a press Start
a wait '"Stage select\. D-pad to choose, A to pick\. Start before moving picks a random stage\."'
b-fork wait '"Stage select\. D-pad to choose, A to pick\. Start before moving picks a random stage\."'
b-base wait 'boot scene: state \d+ scene 9$'
sleep 1

# Player 1 steps to Princess Peach's Castle and picks it, then waits.
a press DDown
a wait ': "Icicle Mountain\. '
a wait 'glide to "Icicle Mountain" ended after \d+ frames: arrived'
a press DRight
a wait ': "Princess Peach.s Castle\. '
a wait 'glide to "Princess Peach.s Castle" ended after \d+ frames: arrived'
a press A
a wait "sss: we picked 0$"
a wait '"Waiting for your opponent\."'

# Player 2 steers its own stage cursor, by the D-pad of its controller 1,
# to Kongo Jungle and picks it; the base port's player 2 picks Random with
# Start. Each hears the coin flip's result from its own side.
b-fork press DDown
b-fork wait ': "Icicle Mountain\. '
b-fork wait 'glide to "Icicle Mountain" ended after \d+ frames: arrived'
b-fork press DRight
b-fork wait ': "Princess Peach.s Castle\. '
b-fork wait 'glide to "Princess Peach.s Castle" ended after \d+ frames: arrived'
b-fork press DRight
b-fork wait ': "Kongo Jungle\. '
b-fork wait 'glide to "Kongo Jungle" ended after \d+ frames: arrived'
b-fork press A
b-fork wait "sss: we picked 2$"
b-fork wait '"Waiting for your opponent\."'
b-base press Start
b-base wait "sss: we picked 30$"
a wait '"(Princess Peach.s Castle, your|Kongo Jungle, opponent.s|Random: [^",]+, opponent.s) pick\."'
b-fork wait '"(Princess Peach.s Castle, opponent.s|Kongo Jungle, your) pick\."'
a wait 'boot scene: state \d+ scene 2$'
b wait 'boot scene: state \d+ scene 2$'
sleep 3
