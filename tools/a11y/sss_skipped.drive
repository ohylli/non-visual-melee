# The skipped scene: with VS mode's stage-select rule set to Random, Start on
# character select enters stage select, which leaves on its first frame with
# the stage already chosen. The fork says "Stage: Corneria." there instead of
# the stage select opening, then the match begins. Character select is set
# up by D-pad as in sss_hover.drive, then the rules screen, which has no
# speech yet, is worked by stick: Down to its fifth row, Stage Selection, and
# Right from On to Random.
# Run with the default --scene title:
#   python tools/a11y/drive.py tools/a11y/sss_skipped.drive
# --no-card starts from the default rules each run, so the rule is On on
# arrival. No line of the run may say "Stage select.": check the output.

# Title screen to the main menu (tools/a11y/main_menu.drive).
wait "state 0 scene 0$"
press Start until "boot scene: game mode"
press A until "boot scene: state 0 scene 1$"
wait '"Main Menu\. 1-P Mode\. '
sleep 1

# VS. Mode, Melee.
press Down
wait '"VS\. Mode\. '
press A
wait '"VS\. Mode\. Melee\. '
sleep 0.3
press A
wait '"Character select\. Player 1, no character\."'
sleep 1

# Fox for player 1, and player 2 made a CPU, which makes the match ready.
press DUp
wait ': "Player 1: closed"$'
press DUp
wait ': "Pichu"$'
press DUp
wait ': "Fox"$'
wait 'glide to "Fox" ended after \d+ frames: arrived'
press A
sleep 1
search ': "Player 2: closed"$' DDown*2 DRight*3 DLeft*3
wait 'glide to "Player 2: closed" ended after \d+ frames: arrived'
press A until 'Ready to fight\. Press Start\.'
sleep 1

# Up to the top bar and right to the rules header; A opens the rules screen.
search ': "Rules"$' DUp*4 DRight*3
wait 'glide to "Rules" ended after \d+ frames: arrived'
press A
wait '"Custom Rules\. No speech yet\."'
sleep 1

# Down four rows to Stage Selection, Right from On to Random, and B back to
# character select, which keeps the rule.
press Down
sleep 0.3
press Down
sleep 0.3
press Down
sleep 0.3
press Down
sleep 0.3
shot build/drive/sss_skipped_row.png
press Right
sleep 0.3
shot build/drive/sss_skipped_random.png
press B
wait '"Character select\. Player 1, '
sleep 1

# Start leaves for stage select, which names the stage chosen in advance
# instead of its opening, then the match begins.
press Start until ': "Stage: [^"]+\."$'
wait 'boot scene: state \d+ scene 2$'
sleep 3
shot build/drive/sss_skipped_match.png
