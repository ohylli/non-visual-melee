# Stocks in a team match through the menus, with a team stock steal: VS
# mode with Teams on, player 1 (Pichu) and a CPU in player slot 2 on the red
# team against a CPU in slot 3 on the blue team, three stocks each, on
# Princess Peach's Castle. Pichu walks off three times: his falls say
# "2 stocks" and "last stock" in your voice, his third nothing (the game's
# announcer calls him out). Start then takes a stock from the teammate:
# both counts are said on the steal's tick, Pichu's rise in your voice and
# the teammate's fall labelled in the opponents' voice. The CPUs'
# characters are random and the teammate may lose a stock before the
# steal, so its count is not pinned; the labels are, as two others makes
# them. About a minute.
# Run with the default --scene title, muted:
#   python tools/a11y/drive.py --muted tools/a11y/match_stock_steal.drive

# Title screen to the main menu (tools/a11y/main_menu.drive).
wait "state 0 scene 0$"
press Start until "boot scene: game mode"
press A until "boot scene: state 0 scene 1$" 20 0.3
wait '"Main Menu\. 1-P Mode\. '
sleep 1

# VS. Mode, Melee.
press Down
wait '"VS\. Mode\. '
press A
wait '"VS\. Mode\. Melee\. '
sleep 0.3
press A
wait '"Character select\. Player 1, no character\."'
sleep 1

# Pichu for player 1, which leaves the hand free.
press DUp
wait ': "Player 1: closed"$'
press DUp
wait ': "Pichu"$'
wait 'glide to "Pichu" ended after \d+ frames: arrived'
press A
sleep 1

# Teams on; player 2 made a CPU, which joins the red team with Pichu, and
# player 3 a CPU, which joins it too, turned to the blue team.
search ': "Teams: off"$' DUp*6 DLeft*4
wait 'glide to "Teams: off" ended after \d+ frames: arrived'
press A
wait ': "Teams: on'
sleep 1
search ': "Player 2: closed"$' DDown*6 DRight*2
wait 'glide to "Player 2: closed" ended after \d+ frames: arrived'
press A until ': "Player 2: CPU, '
sleep 0.5
search ': "Player 3: closed"$' DRight*4
wait 'glide to "Player 3: closed" ended after \d+ frames: arrived'
press A until ': "Player 3: CPU, '
sleep 0.5
press DRight
wait ': "Player 3 team: red"$'
wait 'glide to "Player 3 team: red" ended after \d+ frames: arrived'
press A
wait ': "Blue team'
sleep 1

# Up to the rules header and into Custom Rules: Stock, three stocks.
search ': "Rules: 2-minute KO fest!"$' DUp*6 DLeft*6
wait 'glide to "Rules: 2-minute KO fest!" ended after \d+ frames: arrived'
press A
wait ': "Custom Rules\. Rules: Time\. '
sleep 1
press Right
wait ': "Stock\. '
press Down
wait ': "Stock: 3\. '
press B
wait '"Character select\. '
sleep 1

# Stage select: Princess Peach's Castle.
press Start
wait '"Stage select\. '
sleep 1
press DDown
wait ': "Icicle Mountain\. '
wait 'glide to "Icicle Mountain" ended after \d+ frames: arrived'
press DRight
wait ': "Princess Peach.s Castle\. '
wait 'glide to "Princess Peach.s Castle" ended after \d+ frames: arrived'
press A
wait 'boot scene: state \d+ scene 2$'
sleep 3

# Pichu walks left off the castle, and with the stick held on off the
# respawn platform and the castle again: two stocks, then his last. A
# second hold takes him off a third time: out of the match, nothing said.
press Left 8000
wait 'voice yours: "2 stocks"$' 30
wait 'voice yours: "last stock"$' 20
sleep 4
press Left 8000
sleep 9

# Start takes a stock from the teammate.
press Start
wait 'voice yours: "last stock"$' 5
wait 'voice opponents: "teammate CPU 2, (2 stocks|last stock)"$' 1
sleep 2
quit
