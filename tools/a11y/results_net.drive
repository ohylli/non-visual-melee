# Results online, for tools/a11y/drive_net.py --muted: two instances in one
# session over loopback. Player 1 (instance a, Pichu) sets the rules to one
# stock and walks off Princess Peach's Castle, so player 2 wins. Each hears
# the opening from its own side; a's D-pad press opens both machines' stats
# panels, and each steps its own reading cursor with the D-pad, which quick
# chat leaves alone while speech is on (quick chat logs nothing: the verify
# skill's "Online runs" has the screenshot check). Player 1 readies ("Ready,
# waiting for your opponent."; b hears "Your opponent is ready."),
# un-readies ("Not ready.", "Your opponent is not ready.") and readies
# again; player 2's ready ends results, and both return to character select.
#   python tools/a11y/drive_net.py --muted tools/a11y/results_net.drive
# --muted keeps Accessibility on in both, as for a player: with speech off,
# quick chat keeps the D-pad on results. With --base-b DIR, player 2 is a
# base port build, which says nothing and keeps quick chat on the D-pad: its
# b-base steps wait on scene changes and page with A instead.

# Title screen to the main menu (tools/a11y/main_menu.drive), once the
# session is up: both instances walk the menus a's presses move.
a wait "net: rollback with"
b wait "net: rollback with"
a wait "state 0 scene 0$"
a press Start until "boot scene: game mode"
a press A until "boot scene: state 0 scene 1$" 20 0.3
a wait '"Main Menu\. 1-P Mode\. '
sleep 1

# VS. Mode, Melee.
a press Down
a wait '"VS\. Mode\. '
a press A
a wait '"VS\. Mode\. Melee\. '
sleep 0.3
a press A
a wait '"Character select\. Player 1, no character\."'
b-fork wait '"Character select\. Player 2, no character\."'
b-base wait 'boot scene: state \d+ scene 8$'
sleep 1

# Pichu for player 1, which leaves the hand free.
a press DUp
a wait ': "Player 1: closed"$'
a press DUp
a wait ': "Pichu"$'
a wait 'glide to "Pichu" ended after \d+ frames: arrived'
a press A
sleep 1

# Up to the rules header and into Custom Rules: Stock, one stock.
a search ': "Rules: 2-minute KO fest!"$' DUp*6 DRight*4
a wait 'glide to "Rules: 2-minute KO fest!" ended after \d+ frames: arrived'
a press A
a wait ': "Custom Rules\. Rules: Time\. '
sleep 1
a press Right
a wait ': "Stock\. '
a press Down
a wait ': "Stock: 3\. '
a press Left
a wait ': "2"$'
a press Left
a wait ': "1"$'
a press B
a wait '"Character select\. '
sleep 1

# Player 2 pushes the stick up into the portraits and chooses there.
b press Up 450
b-fork wait '"Holding your coin'
b-base sleep 0.5
sleep 1
b press A
b-fork wait 'Ready to fight\. Press Start\.'
b-base sleep 1
sleep 1

# Stage select: player 1 picks Princess Peach's Castle, player 2 Icicle Mountain
# (a base port player 2 Random), and the default seed's coin flip takes
# player 1's.
a press Start
a wait '"Stage select\. '
b-fork wait '"Stage select\. '
b-base wait 'boot scene: state \d+ scene 9$'
sleep 1
a press DDown
a wait ': "Icicle Mountain\. '
a wait 'glide to "Icicle Mountain" ended after \d+ frames: arrived'
a press DRight
a wait ': "Princess Peach.s Castle\. '
a wait 'glide to "Princess Peach.s Castle" ended after \d+ frames: arrived'
a press A
a wait "sss: we picked 0$"
b-fork press DDown
b-fork wait ': "Icicle Mountain\. '
b-fork wait 'glide to "Icicle Mountain" ended after \d+ frames: arrived'
b-fork press A
b-fork wait "sss: we picked"
b-base press Start
b-base wait "sss: we picked 30$"
a wait 'boot scene: state \d+ scene 2$'
b wait 'boot scene: state \d+ scene 2$'
sleep 3

# Pichu walks left off the castle and falls out of the match.
a press Left 8000
a wait '"Stock Battle\. Winner: (?P<winner>[^."]+)\. 1st (?P=winner), P2, [^"]*2nd Pichu, P1, you, [^"]*Start when ready\."$' 60
b-fork wait '"Stock Battle\. Winner: [^."]+\. 1st [^"]+, P2, you, [^"]*2nd Pichu, P1, [^"]*Start when ready\."$'
b-base wait 'boot scene: state \d+ scene 5$'
sleep 1

# A's D-pad opens both machines' stats panels; each then steps its own
# reading cursor with the D-pad, which quick chat leaves alone.
a press DDown
a wait '"KOs and falls\. KOs\. A and B change page\. D-pad up and down read the rows, left and right switch player\. Z the player.s summary\. Start when ready\."$'
b-fork wait '"KOs and falls\. KOs\. A and B change page\. D-pad up and down read the rows, left and right switch player\. Z the player.s summary\. Start when ready\."$'
a press DDown
a wait '"P2 %winner%, 0"$'
a press DRight
a wait '"%winner%, P2, P1 Pichu, you, 0"$'
b-fork press DDown
b-fork wait '"P1 Pichu, 0"$'
b-fork press DDown
b-fork wait '"Falls"$'
b-base press A
b-base sleep 1
sleep 1

# Player 1 readies, un-readies and readies again, each heard on both sides.
a press Start
a wait '"Ready, waiting for your opponent\."$'
b-fork wait '"Your opponent is ready\."$'
sleep 0.5
a press Start
a wait '"Not ready\."$'
b-fork wait '"Your opponent is not ready\."$'
sleep 0.5
a press Start
a wait '"Ready, waiting for your opponent\."$'
b-fork wait '"Your opponent is ready\."$'
sleep 0.5

# Player 2's ready ends results for both, back to character select.
b press Start
a wait '"Character select\. '
b-fork wait '"Character select\. '
b-base wait 'boot scene: state \d+ scene 8$'
sleep 1
